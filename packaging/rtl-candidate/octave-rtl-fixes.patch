+/// L1 over a row while retaining levels resolved in the full paragraph.
+fn line_bidi_levels(
+    info: &unicode_bidi::BidiInfo<'_>,
+    para: &unicode_bidi::ParagraphInfo,
+    range: Range<usize>,
+) -> Vec<unicode_bidi::Level> {
+    let line = unicode_bidi::ParagraphBidiInfo {
+        text: &info.text[range.clone()],
+        original_classes: info.original_classes[range.clone()].to_vec(),
+        levels: info.levels[range].to_vec(),
+        paragraph_level: para.level,
+        is_pure_ltr: false,
+    };
+    line.reordered_levels(0..line.text.len())
+}
+
+#[test]
+fn octave_line_levels_match_full_document_reference() {
+    for text in [
+        "שלום abc 123  ",
+        "abc \u{2067}مرحبا 123 بالعالم\u{2069} xyz",
+        "שלום \u{2066}abc def ghi\u{2069} עולם",
+        "abc\nمرحبا 123\n\nשלום xyz  ",
+        "abc \u{202b}שלום 123\u{202c} xyz\t ",
+    ] {
+        let info = unicode_bidi::BidiInfo::new(text, None);
+        for para in &info.paragraphs {
+            let boundaries: Vec<_> = (para.range.start..=para.range.end)
+                .filter(|&offset| text.is_char_boundary(offset))
+                .collect();
+            for (i, &start) in boundaries.iter().enumerate() {
+                for &end in &boundaries[i..] {
+                    let range = start..end;
+                    let reference = info.reordered_levels(para, range.clone());
+                    assert_eq!(
+                        line_bidi_levels(&info, para, range.clone()),
+                        reference[range],
+                        "{text:?} at {start}..{end}"
+                    );
+                }
+            }
+        }
+    }
 }

